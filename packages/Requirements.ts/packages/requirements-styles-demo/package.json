{
  "name": "@frenchexdev2/requirements-styles-demo",
  "version": "0.1.0",
  "description": "Scenario-driven demo player (rsd) — 3-FSM orchestrator + built-in scenarios for @frenchexdev2/requirements-styles.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "rsd": "./bin/rsd-entry.mjs"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./ai-adapter": {
      "source": "./src/ai-adapter.ts",
      "types": "./dist/ai-adapter.d.ts",
      "import": "./dist/ai-adapter.js",
      "default": "./dist/ai-adapter.js"
    },
    "./commands": {
      "source": "./src/commands.ts",
      "types": "./dist/commands.d.ts",
      "import": "./dist/commands.js",
      "default": "./dist/commands.js"
    },
    "./event-bridge": {
      "source": "./src/event-bridge.ts",
      "types": "./dist/event-bridge.d.ts",
      "import": "./dist/event-bridge.js",
      "default": "./dist/event-bridge.js"
    },
    "./orchestrator": {
      "source": "./src/orchestrator.ts",
      "types": "./dist/orchestrator.d.ts",
      "import": "./dist/orchestrator.js",
      "default": "./dist/orchestrator.js"
    },
    "./orchestrator-port": {
      "source": "./src/orchestrator-port.ts",
      "types": "./dist/orchestrator-port.d.ts",
      "import": "./dist/orchestrator-port.js",
      "default": "./dist/orchestrator-port.js"
    },
    "./per-ac-fsm": {
      "source": "./src/per-ac-fsm.ts",
      "types": "./dist/per-ac-fsm.d.ts",
      "import": "./dist/per-ac-fsm.js",
      "default": "./dist/per-ac-fsm.js"
    },
    "./per-feature-fsm": {
      "source": "./src/per-feature-fsm.ts",
      "types": "./dist/per-feature-fsm.d.ts",
      "import": "./dist/per-feature-fsm.js",
      "default": "./dist/per-feature-fsm.js"
    },
    "./project-lifecycle-fsm": {
      "source": "./src/project-lifecycle-fsm.ts",
      "types": "./dist/project-lifecycle-fsm.d.ts",
      "import": "./dist/project-lifecycle-fsm.js",
      "default": "./dist/project-lifecycle-fsm.js"
    },
    "./types": {
      "source": "./src/types.ts",
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./ui": {
      "source": "./src/ui.ts",
      "types": "./dist/ui.d.ts",
      "import": "./dist/ui.js",
      "default": "./dist/ui.js"
    }
  },
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@frenchexdev2/requirements-core": "workspace:*",
    "@frenchexdev2/requirements-lib": "workspace:*",
    "@frenchexdev2/requirements-styles": "workspace:*",
    "@frenchexdev2/requirements-wizards": "workspace:*",
    "ajv": "catalog:",
    "commander": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@frenchexdev2/requirements-requirements": "workspace:*"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "req:compliance": "node ../../scripts/qualify-workspace.mjs",
    "req": "requirements",
    "req:compliance:static": "node ../../scripts/check-workspace-compliance.mjs --static"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "bin/",
    "schemas/**/*.json",
    "scenarios/**/*.json",
    "docs/**/*.md"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Stéphane Erard <stephane.erard@gmail.com> (https://serard.dev)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrenchExDev2/Requirements.ts.git",
    "directory": "packages/Requirements.ts/packages/requirements-styles-demo"
  }
}
