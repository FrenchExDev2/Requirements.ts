{
  "name": "@frenchexdev2/requirements-trace",
  "version": "0.1.0",
  "description": "Traceability query engine + REQ→FEAT→AC→TEST graph rendering (Mermaid/DOT). Tier-1 analyzer in the @frenchexdev2/requirements-* hexagonal architecture.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./trace-core": {
      "source": "./src/trace-core.ts",
      "types": "./dist/trace-core.d.ts",
      "import": "./dist/trace-core.js",
      "default": "./dist/trace-core.js"
    },
    "./trace-graph": {
      "source": "./src/trace-graph.ts",
      "types": "./dist/trace-graph.d.ts",
      "import": "./dist/trace-graph.js",
      "default": "./dist/trace-graph.js"
    },
    "./code-trace": {
      "source": "./src/code-trace.ts",
      "types": "./dist/code-trace.d.ts",
      "import": "./dist/code-trace.js",
      "default": "./dist/code-trace.js"
    },
    "./code-marking": {
      "source": "./src/code-marking.mjs",
      "types": "./dist/code-marking.d.mts",
      "import": "./dist/code-marking.mjs",
      "default": "./dist/code-marking.mjs"
    }
  },
  "dependencies": {
    "@frenchexdev2/requirements-core": "workspace:*",
    "@frenchexdev2/requirements-scanner": "workspace:*",
    "@frenchexdev2/requirements-compliance": "workspace:*",
    "@frenchexdev2/requirements-requirements": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "req:compliance": "node ../../scripts/qualify-workspace.mjs",
    "req": "requirements",
    "req:compliance:static": "node ../../scripts/check-workspace-compliance.mjs --static"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.d.ts.map",
    "dist/**/*.mjs",
    "dist/**/*.d.mts"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "author": "Stéphane Erard <stephane.erard@gmail.com> (https://serard.dev)",
  "peerDependencies": {
    "typescript": "catalog:peer"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FrenchExDev2/Requirements.ts.git",
    "directory": "packages/Requirements.ts/packages/requirements-trace"
  }
}
