{
  "version": "0.2",
  "language": "en",
  "ignorePaths": [
    "node_modules",
    "dist",
    "coverage",
    "test-results",
    "schemas/**/*.json"
  ],
  "words": [
    "ajv",
    "BUILTIN",
    "catala",
    "checkpoint",
    "clack",
    "codegen",
    "Commissioned",
    "DCSs",
    "Dyson",
    "ecostruxure",
    "enquirer",
    "FMECA",
    "frenchexdev",
    "gemba",
    "Genchi",
    "genbutsu",
    "Goldratt",
    "Hoshin",
    "Honeywell",
    "iecex",
    "INVEST",
    "kaizen",
    "Kanban",
    "lazydocker",
    "lazygit",
    "Mavin",
    "Modicon",
    "muda",
    "muri",
    "nemawashi",
    "noemit",
    "noopener",
    "noreferrer",
    "normalises",
    "Nuxt",
    "OEM",
    "OEMs",
    "OKR",
    "OKRs",
    "Poppendieck",
    "Reinertsen",
    "ReqIF",
    "Reqview",
    "Robertson",
    "Rockwell",
    "rollup",
    "rolls-royce",
    "Rother",
    "saas",
    "SCADA",
    "Schneider",
    "Schwaber",
    "Sobek",
    "Smalley",
    "Sunsetted",
    "Sutherland",
    "TIMWOODS",
    "Toyota",
    "tsbuildinfo",
    "TSDoc",
    "Volere",
    "verifiables",
    "Womack",
    "Yokogawa",
    "Reqs",
    "stmts"
  ],
  "patterns": [
    {
      "name": "node-import",
      "pattern": "/node:[a-z/]+/g",
      "description": "Built-in Node.js module specifiers like node:path, node:fs/promises"
    }
  ],
  "ignoreRegExpList": [
    "node-import"
  ],
  "allowCompoundWords": true
}
